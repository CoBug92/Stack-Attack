fastlane_version "2.220.0"
require 'json'
require 'fileutils'
require 'dotenv'

Dotenv.load('../project.env')
Dotenv.load

default_platform(:ios)

def project_path
  ENV["XCODE_PROJ_PATH"] || File.join(project_root, "#{required_env('PROJECT_NAME')}.xcodeproj")
end

def required_env(key)
  value = ENV[key].to_s.strip
  UI.user_error!("Missing required environment variable #{key}") if value.empty?

  value
end

def project_root
  File.expand_path('../..', __dir__)
end

def ci_derived_data_path
  File.join(project_root, ".DerivedData", "CI")
end

def ci_simulator_destination
  ENV["CI_XCODE_DESTINATION"] || "generic/platform=iOS Simulator"
end

def xcodegen_application_path
  File.join(project_root, 'Scripts', 'xcodegen', 'Application.yml')
end

def update_xcodegen_setting!(key, value)
  path = xcodegen_application_path
  content = File.read(path)
  found = false
  updated = content.sub(/^(\s*)#{Regexp.escape(key)}:\s*.+$/) do
    found = true
    "#{$1}#{key}: #{value}"
  end
  UI.user_error!("Could not find #{key} in #{path}") unless found

  File.write(path, updated)
end

def current_marketing_version
  match = File.read(xcodegen_application_path).match(/^\s*MARKETING_VERSION:\s*(.+)$/)
  UI.user_error!("Could not find MARKETING_VERSION in #{xcodegen_application_path}") unless match

  match[1].strip
end

def next_patch_version(version)
  parts = version.split('.').map(&:to_i)
  UI.user_error!("Unsupported MARKETING_VERSION format: #{version}") unless parts.length == 3

  parts[2] += 1
  parts.join('.')
end

def update_project_versioning!(marketing_version:, build_number:)
  update_xcodegen_setting!("MARKETING_VERSION", marketing_version)
  update_xcodegen_setting!("INFOPLIST_KEY_CFBundleShortVersionString", marketing_version)
  update_xcodegen_setting!("CURRENT_PROJECT_VERSION", build_number)
  update_xcodegen_setting!("INFOPLIST_KEY_CFBundleVersion", build_number)
end

def app_store_connect_api_key_options
  {
    key_id: required_env("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: required_env("APP_STORE_CONNECT_API_ISSUER_ID"),
    key_content: required_env("APP_STORE_CONNECT_API_KEY_CONTENT"),
    in_house: false,
    is_key_content_base64: true
  }
end

def current_branch
  ENV["GITHUB_REF_NAME"] || git_branch
end

def ensure_deploy_branch!
  branch = current_branch
  allowed_branches = (ENV["DEPLOY_ALLOWED_BRANCHES"] || "master,main").split(",").map(&:strip)
  return if allowed_branches.include?(branch)

  UI.user_error!("Deploy is allowed only from #{allowed_branches.join(', ')}. Current branch: #{branch}")
end

platform :ios do
  desc "Run CI verification"
  lane :ci do
    sh("../generate.sh")
    sh("../swiftlint/swiftlint.sh")
    FileUtils.mkdir_p(ci_derived_data_path)
    sh(
      "xcodebuild",
      "-project", project_path,
      "-scheme", required_env("TARGET_NAME"),
      "-destination", ci_simulator_destination,
      "-derivedDataPath", ci_derived_data_path,
      "CODE_SIGNING_ALLOWED=NO",
      "build"
    )
  end

  desc "Deploy app to Test Flight"
  lane :deploy_to_tf do |options|
    ensure_deploy_branch!

    app_identifier = required_env("BUNDLE_ID")
    team_id = required_env("TEAM_ID")
    api_key = app_store_connect_api_key(app_store_connect_api_key_options)

    setup_ci(
      force: true,
      keychain_name: "stack_attack_ci",
      timeout: 0
    )
    match(
      api_key: api_key
    )

    marketing_version = current_marketing_version
    latest_build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_identifier,
      version: marketing_version,
      initial_build_number: 1
    )
    build_number = latest_build_number + 1

    if options[:bump_version].to_s == "true"
      marketing_version = next_patch_version(marketing_version)
    end

    update_project_versioning!(
      marketing_version: marketing_version,
      build_number: build_number
    )

    sh("../generate.sh")

    gym(
      project: project_path,
      configuration: "Release",
      scheme: required_env("TARGET_NAME"),
      silent: false,
      clean: true,
      export_method: "app-store",
      export_team_id: team_id,
      include_symbols: true,
      xcargs: "DEVELOPMENT_TEAM=#{team_id}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          app_identifier => "match AppStore #{app_identifier}",
        }
      }
    )
    upload_to_testflight(
      api_key: api_key
    )
    version_paths = [xcodegen_application_path]
    git_add(path: version_paths)
    git_commit(
      path: version_paths,
      message: 'Bump version and build number [skip ci]',
      allow_nothing_to_commit: true
    )
    push_to_git_remote(
      local_branch: current_branch,
      remote_branch: current_branch,
    )
  end
end
